# Скопируйте в .env и заполните локально. START_BOT.bat загружает .env сам.
# Прямая команда python -m store_core bot читает только переменные окружения.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
CATALOG_PATH=catalog/mvp_catalog.csv
SQLITE_PATH=data/store.sqlite3
# local или telegram; local пишет только ID заявки в журнал, без контактов.
NOTIFICATION_BACKEND=telegram
STORE_TEST_MODE=0
# Имитация первой ошибки каждой заявки разрешена только при STORE_TEST_MODE=1.
NOTIFICATION_FAIL_FIRST=0
